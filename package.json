{
  "name": "horizon",
  "version": "1.0.0",
  "description": "A panoramic wallpaper manager and rotation engine for COSMIC desktops.",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "horizon": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "desktop": "electron .",
    "build": "npm run build --prefix ui",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "linux",
    "cosmic-desktop",
    "wallpaper-manager",
    "multi-monitor",
    "panoramic-wallpaper",
    "electron",
    "desktop",
    "wallpaper-rotation"
  ],
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
